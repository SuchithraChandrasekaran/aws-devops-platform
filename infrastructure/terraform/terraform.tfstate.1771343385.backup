            "dashboard_body": "{\"widgets\":[{\"height\":6,\"properties\":{\"metrics\":[[\"MyApp/Metrics\",\"CPUUtilization\",{\"label\":\"CPU %\",\"stat\":\"Average\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"CPU Utilization\",\"yAxis\":{\"left\":{\"max\":100,\"min\":0}}},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":0},{\"height\":6,\"properties\":{\"metrics\":[[\"MyApp/Metrics\",\"MemoryUtilization\",{\"label\":\"Memory %\",\"stat\":\"Average\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"Memory Utilization\",\"yAxis\":{\"left\":{\"max\":100,\"min\":0}}},\"type\":\"metric\",\"width\":12,\"x\":12,\"y\":0},{\"height\":6,\"properties\":{\"metrics\":[[\"MyApp/Metrics\",\"DiskUtilization\",{\"label\":\"Disk %\",\"stat\":\"Average\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"Disk Utilization\",\"yAxis\":{\"left\":{\"max\":100,\"min\":0}}},\"type\":\"metric\",\"width\":8,\"x\":0,\"y\":6},{\"height\":6,\"properties\":{\"metrics\":[[\"MyApp/Metrics\",\"NetworkThroughput\",{\"label\":\"Network MB/s\",\"stat\":\"Average\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"Network Throughput\"},\"type\":\"metric\",\"width\":8,\"x\":8,\"y\":6},{\"height\":6,\"properties\":{\"metrics\":[[\"MyApp/Metrics\",\"RequestCount\",{\"label\":\"Requests\",\"stat\":\"Sum\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Sum\",\"title\":\"Request Count\"},\"type\":\"metric\",\"width\":8,\"x\":16,\"y\":6},{\"height\":6,\"properties\":{\"metrics\":[[\"MyApp/Logs\",\"ErrorCountFromLogs\",{\"label\":\"Errors\",\"stat\":\"Sum\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Sum\",\"title\":\"Error Count\"},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":12},{\"height\":6,\"properties\":{\"metrics\":[[\"MyApp/Logs\",\"APIResponseTime\",{\"label\":\"Latency (ms)\",\"stat\":\"Average\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"API Response Time\"},\"type\":\"metric\",\"width\":12,\"x\":12,\"y\":12},{\"height\":6,\"properties\":{\"metrics\":[[\"MyApp/Metrics\",\"DatabaseConnections\",{\"label\":\"DB Connections\",\"stat\":\"Average\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"Database Connections\"},\"type\":\"metric\",\"width\":8,\"x\":0,\"y\":18},{\"height\":6,\"properties\":{\"metrics\":[[\"MyApp/Metrics\",\"CacheHitRate\",{\"label\":\"Cache Hit %\",\"stat\":\"Average\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"Cache Hit Rate\",\"yAxis\":{\"left\":{\"max\":100,\"min\":0}}},\"type\":\"metric\",\"width\":8,\"x\":8,\"y\":18},{\"height\":6,\"properties\":{\"metrics\":[[\"MyApp/Metrics\",\"QueueDepth\",{\"label\":\"Queue Depth\",\"stat\":\"Maximum\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Maximum\",\"title\":\"Queue Depth\"},\"type\":\"metric\",\"width\":8,\"x\":16,\"y\":18},{\"height\":3,\"properties\":{\"metrics\":[[\"MyApp/Metrics\",\"CPUUtilization\",{\"stat\":\"Average\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"Current CPU\",\"view\":\"singleValue\"},\"type\":\"metric\",\"width\":6,\"x\":0,\"y\":24},{\"height\":3,\"properties\":{\"metrics\":[[\"MyApp/Metrics\",\"MemoryUtilization\",{\"stat\":\"Average\"}]],\"period\":300,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"Current Memory\",\"view\":\"singleValue\"},\"type\":\"metric\",\"width\":6,\"x\":6,\"y\":24},{\"height\":3,\"properties\":{\"metrics\":[[\"MyApp/Logs\",\"ErrorCountFromLogs\",{\"stat\":\"Sum\"}]],\"period\":3600,\"region\":\"us-east-1\",\"stat\":\"Sum\",\"title\":\"Errors (Last Hour)\",\"view\":\"singleValue\"},\"type\":\"metric\",\"width\":6,\"x\":12,\"y\":24},{\"height\":3,\"properties\":{\"metrics\":[[\"MyApp/Metrics\",\"RequestCount\",{\"stat\":\"Sum\"}]],\"period\":3600,\"region\":\"us-east-1\",\"stat\":\"Sum\",\"title\":\"Requests (Last Hour)\",\"view\":\"singleValue\"},\"type\":\"metric\",\"width\":6,\"x\":18,\"y\":24},{\"height\":6,\"properties\":{\"alarms\":[\"arn:aws:cloudwatch:us-east-1:000000000000:alarm:high-cpu-utilization\",\"arn:aws:cloudwatch:us-east-1:000000000000:alarm:high-memory-utilization\",\"arn:aws:cloudwatch:us-east-1:000000000000:alarm:high-error-count\",\"arn:aws:cloudwatch:us-east-1:000000000000:alarm:high-api-latency\"],\"title\":\"Alarm Status\"},\"type\":\"alarm\",\"width\":12,\"x\":0,\"y\":27},{\"height\":6,\"properties\":{\"query\":\"SOURCE '/aws/application/myapp' | fields @timestamp, @message | filter @message like /ERROR/ | sort @timestamp desc | limit 20\",\"region\":\"us-east-1\",\"title\":\"Recent Errors\"},\"type\":\"log\",\"width\":12,\"x\":12,\"y\":27}]}",
